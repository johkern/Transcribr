# Transcribr Environment Configuration
# Copy this file to .env and fill in your values

# Note: API keys should be configured in the app's Settings screen
# This file is for development/build-time configuration only

# App Configuration
APP_NAME=Transcribr
APP_VERSION=1.0.0

# Build Configuration
NODE_ENV=development

# Optional: For development/testing
# These values are NOT used by the app at runtime
# Runtime API keys are configured in the Settings screen
EXAMPLE_GEMINI_API_KEY=your-gemini-api-key-here
EXAMPLE_OPENAI_API_KEY=your-openai-api-key-here

# Note: Never commit your actual API keys to version control!
